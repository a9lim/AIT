-- nf outputs the normal form of the input blc term
let
  id    = \x.x;
  true  = \t\f.t;
  false = \t\f.f;
  nil   = false;
  cons  = \x\y\z. z x y;
  cons0 = cons true;
  cons1 = cons false;
  compose = \f\g\x. f (g x);
  cons00 = compose cons0 cons0;
  cons01 = compose cons0 cons1;
  tail = \l. l false;
  succ = \n\f\x.f (n f x);
  zero = false;
  one = id;

  -- data T = L (T -> T)  -- Lam
  --        | A T T       -- App
  --        | V Int       -- de Bruijn level variable 
  caseT = \t\l\a\v. t l a v;
  L = \f.     \l\a\v. l f;
  A = \t1\t2. \l\a\v. a t1 t2;
  V = \d.     \l\a\v. v d;

  -- parser after int.lam (cons' cells, the variable's code as its lookup,
  -- skipvar), ported by a9lim
  parseval = (\x. x x) (\x. (\parseval. \cont.
      (\next. \xs. xs (\b0. b0 (\ys\rest. rest next) cont) (xs xs xs))
      (\b1. parseval (\t1. b1
         (cont (\ctx. L (\v. t1 (\zx\zy. zx v (zy ctx)))))
         (parseval (\t2. cont (\ctx. let tc1 = t1 ctx; A1 = A tc1
           in tc1 (\f. f) (\_\_. A1) (\_. A1) (t2 ctx)))))))
    (x x));

  ser = \t\lvl. caseT t
    -- Lambda: apply to a free variable to further reduce whnf
    (\f.     compose cons00 (ser (f (V lvl)) (succ lvl)))
    -- Application
    (\t1\t2. compose cons01 (compose (ser t1 lvl) (ser t2 lvl)))
    -- Variable
    (\v.     compose (v tail) (compose (lvl cons1) cons0));

  nf = parseval (\t. ser (t t) zero)
in nf

-- universal machine for Levenshtein binary lambda calculus (BLC2): 416 bits
-- a9lim reduced it from 500 bits: one bit reader, get, serves the parser,
-- the Levenshtein delimiter and the digit accumulator, with the reader's
-- continuation held outside its fixpoint.
let
 id = \x.x;
 true = \x\y.x;

 -- get k (bit:bits) = k bit bits, reading the next byte when bits is nil
 get = \k.let loop = \bits.bits (\b\tail\ignored.k b tail) (\bytes.bytes loop) in loop;

 -- readbit f cont n input = cont (n . n . if next_input_bit then f else id) input'
 readbit = \f\cont\n.get (\bit.cont (\x.n (n (bit x (f x)))));

 -- delimit f cont (levenstein_code_for_n_on_input) = cont (f^n) input'
 delimit = \f\cont.get (\bit.bit (cont id) (delimit (readbit f) (\n.n cont f)));

 -- binary LC interpreter
 -- int cont input = cont (\free.parsed) input'
 int = \cont.get (\bit0.bit0
   (get (\bit1.int (\exp.bit1 (cont (\args\arg.exp (\z.z arg args)))
        (int (\exp2.cont (\args.exp args (exp2 args)))))))
   (delimit (\l.l bit0) (\n.cont (\args.n args true))));

 -- loop
 omega = omega
in
 -- binary LC universal machine for closed programs
 \bytes.bytes (int (\exp\bits.exp omega))
 -- assuming closed programs, (int id) gives a non-strict machine of 393 bits
